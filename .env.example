# Google Cloud project (used for both Vertex AI and Firestore)
GOOGLE_CLOUD_PROJECT=cornice-collective
FIRESTORE_PROJECT_ID=cornice-collective
FIRESTORE_DATABASE_ID=(default)

# Vertex AI (default — authenticates via ADC locally and Service Account on Cloud Run)
GEMINI_BACKEND=vertex
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-4-neon
GEMINI_THINKING_LEVEL=medium

# Optional: switch to local JSON files instead of Firestore
# LOCAL_DATA_DIR=./data

# Optional: use an AI Studio API key instead of Vertex AI
# GEMINI_BACKEND=api
# GEMINI_API_KEY=your-key-here

# Simulation tuning
MAX_MEMBERS=10
STORIES_PER_ISSUE=2
ISSUES_PER_OPEN_CALL=3
